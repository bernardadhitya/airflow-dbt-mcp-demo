# Copy to .env (cp .env.example .env). Defaults are fine for local-only use.
AIRFLOW_UID=50000

# Airflow UI admin
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Read-only (Viewer role) user the MCP server logs in as
MCP_VIEWER_USER=mcp_viewer
MCP_VIEWER_PASSWORD=mcp_viewer

# Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
JWT_SECRET=local-dev-jwt-secret
